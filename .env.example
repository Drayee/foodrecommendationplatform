# ===========================================================
# 寻味 · 环境变量样例
# 复制为 .env 后按需修改；不配置任何一项也能本地跑起来（全部有安全默认值）
# ===========================================================

# ---------- Django ----------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TIME_ZONE=Asia/Shanghai
LOG_LEVEL=INFO

# ---------- 数据库（默认 SQLite；要 MySQL 就改这里）----------
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=food_platform
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ---------- 缓存 / 会话（留空用本地文件缓存）----------
# REDIS_URL=redis://127.0.0.1:6379/1

# ---------- 大模型（OpenAI 兼容网关；不填则走本地检索回答）----------
LLM_ENABLED=1
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1500

# ---------- RAG ----------
RAG_CHUNK_SIZE=420
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_EMBED_DIM=1024
RAG_BM25_WEIGHT=0.5

# ---------- 网络搜索 ----------
WEBSEARCH_TIMEOUT=8
WEBSEARCH_MAX_RESULTS=8
WEBSEARCH_CACHE_TTL=3600
WEBSEARCH_OFFLINE_FALLBACK=1

# ---------- 推荐 ----------
RECOMMEND_FEED_SIZE=12
RECOMMEND_W_CONTENT=0.45
RECOMMEND_W_CF=0.30
RECOMMEND_W_HOT=0.15
RECOMMEND_W_FRESH=0.10
RECOMMEND_MMR_LAMBDA=0.7

# ---------- 邮件（验证码登录；不填则演示模式，验证码直接回显）----------
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=you@qq.com
# EMAIL_HOST_PASSWORD=your-smtp-auth-code
# EMAIL_USE_SSL=1
# DEFAULT_FROM_EMAIL=you@qq.com
DEMO_VERIFY_CODE=1
